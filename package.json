{
  "name": "reconai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently \"npm run dev:server\" \"npm run watch:client\"",
    "dev:hmr": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "watch:client": "vite build --watch",
    "dev:server": "node --watch backend/index.js",
    "build": "vite build",
    "start": "node backend/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
