    "csv-stringify": "^6.5.0",
    "express": "^4.18.2",
    "jpeg-js": "^0.4.4",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
